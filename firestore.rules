rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Firebase's Email/Password provider allows public self-service sign-up
    // via its REST API regardless of whether the app's own UI exposes a
    // signup form -- anyone with the (public, non-secret) apiKey can create
    // an account directly. So "is signed in" alone does NOT mean "was
    // invited". The invitedEmails collection is the actual invite gate: the
    // admin adds a document (ID = lowercased email) via Console/Admin SDK
    // for each invited student, and only signed-in users whose email has a
    // matching document may read course content.
    function isInvited() {
      return isSignedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/invitedEmails/$(request.auth.token.email.lower()));
    }

    // Course content is curated by the admin outside the app (Firebase
    // Console or a script using the Admin SDK, which bypasses these rules).
    // Only invited users may read the catalog; the client never writes to
    // these collections.
    //
    // Per-course visibility -- third attempt (2026-09-08). The first two
    // (invitedEmails.courses via get(), courses.visibleTo array on the
    // course itself) both relied on array-membership checks ("x in
    // someArray") and were confirmed broken for list()/getDocs(): verified
    // via both production Firestore REST calls and the local emulator that
    // an unconstrained list query with an array-membership rule condition
    // either returns every document unfiltered, or -- if a matching
    // array-contains-any where() is added -- fails the whole query outright
    // with an evaluation error. get() against the same rule always denies
    // correctly; only list() breaks. This is a real engine limitation, not
    // a data-modeling mistake -- confirmed reproducible from scratch, not
    // just a one-off result from the first two attempts.
    //
    // This version avoids array membership entirely:
    //   - `restricted` is a scalar boolean (every course must have it set
    //     explicitly -- there is no "unset means open" fallback, because a
    //     matching where() can't filter on a missing field). Equality
    //     checks against a scalar field in a list rule ARE reliable
    //     (confirmed via emulator: resource.data.restricted == false paired
    //     with where('restricted','==',false) filters correctly).
    //   - courses default to restricted: true. Per-course access for a
    //     restricted course is an existence check against a subcollection
    //     doc (courses/{courseId}/assigned/{email}), which get() enforces
    //     correctly (confirmed via emulator). list() still can't evaluate
    //     exists() reliably for an unconstrained query, so the client never
    //     lists restricted courses directly -- see fetchCourses() in
    //     ui/src/lib/db.js for the two-phase read this requires.
    function existsAssigned(courseId) {
      return exists(/databases/$(database)/documents/courses/$(courseId)/assigned/$(request.auth.token.email.lower()));
    }

    match /courses/{courseId} {
      allow get: if isInvited() && (resource.data.restricted != true || existsAssigned(courseId));
      allow list: if isInvited() && resource.data.restricted == false;
      allow write: if false;
    }

    // Per-course allowlist. Doc ID = lowercased email (so existsAssigned()
    // above is a direct single-doc get()). `email` is also duplicated as a
    // field because the client needs to ask "which courses am I assigned
    // to" via a collectionGroup('assigned') query -- collectionGroup
    // queries can only filter on document fields, not on the last path
    // segment, so the doc ID alone isn't queryable that way.
    match /{path=**}/assigned/{email} {
      allow list: if isInvited() && resource.data.email == request.auth.token.email.lower();
      allow get, write: if false;
    }

    match /lessons/{lessonId} {
      allow read: if isInvited();
      allow write: if false;
    }

    // Optional chapter grouping within a course. A lesson without a
    // `module` field just renders ungrouped, same as before this existed.
    match /modules/{moduleId} {
      allow read: if isInvited();
      allow write: if false;
    }

    match /resources/{resourceId} {
      allow read: if isInvited();
      allow write: if false;
    }

    match /lesson_faqs/{faqId} {
      allow read: if isInvited();
      allow write: if false;
    }

    match /lesson_resources/{lessonResourceId} {
      allow read: if isInvited();
      allow write: if false;
    }

    // Admin-managed invite list. ID = lowercased invited email. Never
    // readable/writable by clients -- only via Console or the Admin SDK,
    // both of which bypass these rules.
    match /invitedEmails/{email} {
      allow read, write: if false;
    }

    // Not written by the app yet, but scoped correctly for if/when a profile
    // feature is added.
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Self-reported learning progress: one doc per (user, course), created
    // on demand the first time a student marks progress. No auto-assignment.
    match /progress/{progressId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && progressId == request.auth.uid + "_" + request.resource.data.course
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.course is string
        && request.resource.data.course.size() > 0
        && request.resource.data.course.size() < 200
        && request.resource.data.status in ["Not Started", "In Progress", "Completed"]
        && request.resource.data.keys().hasOnly(["userId", "course", "status", "completedLessons"])
        && (!("completedLessons" in request.resource.data) || request.resource.data.completedLessons is list);

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.course == resource.data.course
        && request.resource.data.status in ["Not Started", "In Progress", "Completed"]
        && request.resource.data.keys().hasOnly(["userId", "course", "status", "completedLessons"])
        && (!("completedLessons" in request.resource.data) || request.resource.data.completedLessons is list);
    }
  }
}
