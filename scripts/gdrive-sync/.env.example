# Google Drive 資料夾 ID（欲同步的課程影片資料夾）
GDRIVE_FOLDER_ID=

# Google Drive Service Account 金鑰檔路徑（唯讀權限：drive.readonly 或更窄的 drive.metadata.readonly）
GDRIVE_SERVICE_ACCOUNT_PATH=./service-account-drive.json

# Firebase Admin SDK Service Account 金鑰檔路徑（僅需 Firestore 權限）
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account-firebase.json
